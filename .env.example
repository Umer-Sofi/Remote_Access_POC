# Copy to .env and fill in. `scripts/dev-env.sh` generates one with random secrets.

# LiveKit API credentials, shared by livekit, egress and broker.
# The key NAME must match `webhook.api_key` in infra/livekit.yaml.
LIVEKIT_API_KEY=poc-key
LIVEKIT_API_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# IP that LiveKit advertises in ICE candidates.
#   laptop dev, target on the same machine: 127.0.0.1
#   target on your LAN (e.g. the Windows PC): this machine's LAN IP
#   cloud VM: the VM's public IP
LIVEKIT_NODE_IP=127.0.0.1

# URL that browsers and endpoint clients use to reach LiveKit.
#   dev: ws://localhost:7880      prod: wss://livekit.example.com
LIVEKIT_PUBLIC_URL=ws://localhost:7880

POSTGRES_PASSWORD=change-me

# Signs operator login JWTs.
JWT_SECRET=change-me

# POC IdentityProvider: local operators, "user:password" comma separated.
OPERATORS=alice:alice-pass,bob:bob-pass

# Shared secret endpoint clients present in their `hello` frame.
ENDPOINT_SECRET=change-me

# POC PostureProvider: comma-separated target IDs allowed to be connected to.
# "*" allows any registered target.
TARGET_ALLOWLIST=*

# If true, a session is ended when recording has not started within 20 s of the
# target publishing video. That is the "recording cannot be bypassed" guarantee.
REQUIRE_RECORDING=true
