<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>        <string>__BUNDLE_ID__</string>
  <key>CFBundleName</key>              <string>Remote Access</string>
  <key>CFBundleDisplayName</key>       <string>Remote Access</string>
  <key>CFBundleExecutable</key>        <string>RemoteAccessEndpoint</string>
  <key>CFBundlePackageType</key>       <string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key>           <string>1</string>
  <key>LSMinimumSystemVersion</key>    <string>13.0</string>
  <!-- Accessory app: no Dock icon; UI is only the consent prompt and the session banner. -->
  <key>LSUIElement</key>               <true/>
  <key>NSHighResolutionCapable</key>   <true/>
  <!-- remoteaccess://enroll?… links from the invite page open this app. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>       <string>Remote Access invite</string>
      <key>CFBundleURLSchemes</key>    <array><string>remoteaccess</string></array>
    </dict>
  </array>
  <!-- Lets the app reach a broker on the local network over http/ws (LAN testing). Public servers should use https/wss. -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
