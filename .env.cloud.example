# Settings for scripts/cloud-up.sh (LiveKit Cloud + Cloudflare tunnel).
# scripts/cloud-up.sh creates .env.cloud from this with random secrets; then
# fill in the three LIVEKIT_* values from cloud.livekit.io → your project → Settings → Keys.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
ENDPOINT_SECRET=change-me
OPERATORS=alice:alice-pass
